{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaflow.local/schemas/case.schema.json",
  "title": "QA Flow v2 Test Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "title", "path", "priority", "status", "tags", "precondition", "steps", "automationLinks", "externalReferences", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "path": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "priority": { "enum": ["low", "medium", "high", "critical"] },
    "status": { "enum": ["active", "draft", "archived"] },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "precondition": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "action", "expectedResult"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["given", "when", "then", "and"] },
          "action": { "type": "string", "minLength": 1 },
          "expectedResult": { "type": "string", "minLength": 1 }
        }
      }
    },
    "automationLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["framework", "path"],
        "properties": {
          "framework": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "testName": { "type": "string" }
        }
      }
    },
    "externalReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "value"],
        "properties": {
          "system": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 },
          "url": { "type": "string" }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
