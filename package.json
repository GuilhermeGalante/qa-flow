{
  "name": "test-front-end",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "vite",
    "dev:desktop:frontend": "vite --mode desktop",
    "build": "tsc -b && vite build",
    "build:desktop:frontend": "tsc -b && vite build --mode desktop",
    "lint": "eslint .",
    "test": "node --test src/domain/validation.test.ts src/domain/importers.test.ts src/domain/migration.test.ts src/domain/demands.test.ts src/app/qaApplicationServices.test.ts src/platform/web/webWorkspaceAdapter.test.ts src/platform/tauri/tauriAdapters.test.ts && node scripts/verify-schemas.mjs",
    "check": "npm run lint && npm run test && npm run build",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "build:desktop:no-bundle": "tauri build --no-bundle",
    "doctor:desktop": "node scripts/doctor-desktop.mjs",
    "verify:release-version": "node scripts/verify-release-version.mjs",
    "verify:desktop-distribution": "node scripts/verify-desktop-distribution.mjs",
    "check:desktop:frontend": "npm run build:desktop:frontend && node scripts/verify-desktop-isolation.mjs",
    "check:desktop": "npm run check:desktop:frontend && npm run doctor:desktop -- --strict && npm run verify:desktop-distribution && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml && npm run build:desktop:no-bundle",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-pdf/renderer": "^4.4.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tauri-apps/api": "^2.11.1",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.7.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.12.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "js-yaml": "^5.4.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
